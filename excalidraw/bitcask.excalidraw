      "text": "record_offset\n|\nv\n+-------+-----------+--------+-----+-------+\n| CRC32 | timestamp | sizes  | key | value |\n+-------+-----------+--------+-----+-------+\n<---------------- total_sz ---------------->",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "record_offset\n|\nv\n+-------+-----------+--------+-----+-------+\n| CRC32 | timestamp | sizes  | key | value |\n+-------+-----------+--------+-----+-------+\n<---------------- total_sz ---------------->",
      "autoResize": true,
