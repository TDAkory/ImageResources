      "created": 1791443079984,
      "link": null,
      "locked": false,
      "text": "bitcask-dir/\n|-- 10.bitcask.data\n|-- 10.bitcask.hint\n|-- 11.bitcask.data\n|-- 11.bitcask.hint\n|-- bitcask.write.lock\n`-- bitcask.merge.lock",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bitcask-dir/\n|-- 10.bitcask.data\n|-- 10.bitcask.hint\n|-- 11.bitcask.data\n|-- 11.bitcask.hint\n|-- bitcask.write.lock\n`-- bitcask.merge.lock",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RCnP8vMS4VRxbjn80qmXf",
      "type": "text",
      "x": 198.60010166768245,
      "y": 1094.665059094075,
      "width": 649,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6T",
      "roundness": null,
      "seed": 2006402890,
      "version": 314,
      "versionNonce": 1180450674,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792583656355,
      "created": 1791443092728,
      "link": null,
      "locked": false,
      "text": "+--------+     +--------------+     +---------------------+\n| create | --> | active/write | --> | read-only data file |\n+--------+     +--------------+     +---------------------+\n                                               |\n                                               v\n                                        +-------------+\n                                        | merge input |\n                                        +-------------+\n                                               |\n                                               v\n                                       +----------------+\n                                       | pending delete |\n                                       +----------------+\n                                               |\n                                               v\n                                           [deleted]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+--------+     +--------------+     +---------------------+\n| create | --> | active/write | --> | read-only data file |\n+--------+     +--------------+     +---------------------+\n                                               |\n                                               v\n                                        +-------------+\n                                        | merge input |\n                                        +-------------+\n                                               |\n                                               v\n                                       +----------------+\n                                       | pending delete |\n                                       +----------------+\n                                               |\n                                               v\n                                           [deleted]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9NPjPW09qI30Mn2uFxjzE",
      "type": "text",
      "x": 1697.6646959139816,
      "y": 412.0369079599677,
      "width": 649,
      "height": 100,
      "angle": 0,
