      "updated": 1792584320935,
      "created": 1791443113012,
      "link": null,
      "locked": false,
      "text": "Data file record\n+------+----------+------+--------+--------+--------+\n|CRC32 |timestamp |key_sz|value_sz|  key   | value  |\n+------+----------+------+--------+--------+--------+\n|<-4B->|<---4B--->|<-2B->|<--4B-->|variable|variable|\n\nrecord_size = 14 + key_sz + value_sz",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data file record\n+------+----------+------+--------+--------+--------+\n|CRC32 |timestamp |key_sz|value_sz|  key   | value  |\n+------+----------+------+--------+--------+--------+\n|<-4B->|<---4B--->|<-2B->|<--4B-->|variable|variable|\n\nrecord_size = 14 + key_sz + value_sz",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HZ6oIeHfMxmWDFegFduBs",
      "type": "text",
      "x": 1096.0700143898312,
      "y": 565.1690949911426,
