      "created": 1791443104212,
      "link": null,
      "locked": false,
      "text": "Data file 是连续的变长 record\n+----------+----------+----------+----------+-----+-------+\n| record 0 | record 1 | record 2 | record 3 | ... | tail  |\n+----------+----------+----------+----------+-----+-------+",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data file 是连续的变长 record\n+----------+----------+----------+----------+-----+-------+\n| record 0 | record 1 | record 2 | record 3 | ... | tail  |\n+----------+----------+----------+----------+-----+-------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "f9uPy3WyCus82NwgqT7ff",
      "type": "text",
      "x": 1704.7064736106768,
      "y": 614.9233895000327,
      "width": 583,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
