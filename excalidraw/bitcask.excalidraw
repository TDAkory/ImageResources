      "created": 1791188668582,
      "link": null,
      "locked": false,
      "text": "Put(key, value)\n  -> append {CRC, timestamp, sizes, key, value} to data file\n  -> KeyDir[key] = {file_id, record_offset, total_size, timestamp}\n\nGet(key)\n  -> lookup KeyDir\n  -> pread one complete record from data file\n\nRecover\n  -> scan hint file when valid, otherwise scan data file\n  -> rebuild KeyDir and per-file statistics",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Put(key, value)\n  -> append {CRC, timestamp, sizes, key, value} to data file\n  -> KeyDir[key] = {file_id, record_offset, total_size, timestamp}\n\nGet(key)\n  -> lookup KeyDir\n  -> pread one complete record from data file\n\nRecover\n  -> scan hint file when valid, otherwise scan data file\n  -> rebuild KeyDir and per-file statistics",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pmt8xz52jP26ksQE-ziQ9",
      "type": "text",
      "x": -115.05680486913195,
      "y": 399.56251441196844,
      "width": 934.1565440921028,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6R",
      "roundness": null,
      "seed": 821411286,
      "version": 79,
      "versionNonce": 1870133014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791443070966,
      "created": 1791443065488,
      "link": null,
      "locked": false,
      "text": "Memory                                             Disk\n  +--------------------------------+\n  +--------------------------------+\n  | KeyDir                         | -- lookup ---> | <id>.bitcask.data\n  | key -> file_id/offset/size     |                | CRC | sizes | key | value\n  |                                |\n  +--------------------------------+\n  | fstats: live/dead per file     | <-- rebuild -- | <id>.bitcask.hint\n  +--------------------------------+                | key | file_id/offset/size",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Memory                                             Disk\n  +--------------------------------+\n  +--------------------------------+\n  | KeyDir                         | -- lookup ---> | <id>.bitcask.data\n  | key -> file_id/offset/size     |                | CRC | sizes | key | value\n  |                                |\n  +--------------------------------+\n  | fstats: live/dead per file     | <-- rebuild -- | <id>.bitcask.hint\n  +--------------------------------+                | key | file_id/offset/size",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mdx76DnmIC02HaO2JYWv3",
      "type": "text",
      "x": 434.0399353603874,
      "y": 746.8084198056505,
      "width": 242,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
