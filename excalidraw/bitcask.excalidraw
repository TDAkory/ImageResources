      "index": "b6X",
      "roundness": null,
      "seed": 659479730,
      "version": 261,
      "versionNonce": 932609586,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791465117484,
      "created": 1791465082950,
      "link": null,
      "locked": false,
      "text": "Hint File Record\n+----------+------+--------+----------+---------+--------+\n|timestamp |key_sz|total_sz|tombstone |  offset |  key   |\n+----------+------+--------+----------+---------+--------+\n|<---4B--->|<-2B->|<--4B-->|<--1bit-->|<-63bit->|variable|\n\nfixed hint header = 18 bytes",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hint File Record\n+----------+------+--------+----------+---------+--------+\n|timestamp |key_sz|total_sz|tombstone |  offset |  key   |\n+----------+------+--------+----------+---------+--------+\n|<---4B--->|<-2B->|<--4B-->|<--1bit-->|<-63bit->|variable|\n\nfixed hint header = 18 bytes",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3hQ0co8YiQwgS5I2-XZFq",
      "type": "text",
      "x": 2793.8222429153457,
      "y": 360.47057184417145,
      "width": 845.6449710917593,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
