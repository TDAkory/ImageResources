      "link": null,
      "locked": false,
      "text": "Block-Based Table SST\n+-----------------------------------------------+\n| Data Blocks                                   |\n+-----------------------------------------------+\n| Index / Filter                                |\n+-----------------------------------------------+\n| Properties                                    |\n|   RocksDB built-in properties                 |\n|   TiKV RangeProperties                        |\n|   TiKV MvccProperties       # TxnKV write CF  |\n+-----------------------------------------------+\n| Metaindex                                     |\n+-----------------------------------------------+\n| Footer                                        |\n+-----------------------------------------------+",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Block-Based Table SST\n+-----------------------------------------------+\n| Data Blocks                                   |\n+-----------------------------------------------+\n| Index / Filter                                |\n+-----------------------------------------------+\n| Properties                                    |\n|   RocksDB built-in properties                 |\n|   TiKV RangeProperties                        |\n|   TiKV MvccProperties       # TxnKV write CF  |\n+-----------------------------------------------+\n| Metaindex                                     |\n+-----------------------------------------------+\n| Footer                                        |\n+-----------------------------------------------+",
      "autoResize": true,
