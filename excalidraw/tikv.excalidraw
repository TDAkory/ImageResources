      "link": null,
      "locked": false,
      "text": "lock CF\n+------+------------------------------+\n| 0x7a | memcomparable(raw user key)  |\n+------+------------------------------+\n\ndefault / write CF\n+------+-----------------------------+--------------+\n| 0x7a | memcomparable(raw user key) | desc_u64(ts) |\n+------+-----------------------------+--------------+\n| 1 B  | variable                    | 8 B          |\n+------+-----------------------------+--------------+",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "lock CF\n+------+------------------------------+\n| 0x7a | memcomparable(raw user key)  |\n+------+------------------------------+\n\ndefault / write CF\n+------+-----------------------------+--------------+\n| 0x7a | memcomparable(raw user key) | desc_u64(ts) |\n+------+-----------------------------+--------------+\n| 1 B  | variable                    | 8 B          |\n+------+-----------------------------+--------------+",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QDL0DbSai67765eWvgPSM",
      "type": "text",
      "x": 1418.5361200212328,
      "y": 1126.334705042999,
      "width": 957.7594361133672,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b69",
      "roundness": null,
      "seed": 2058136613,
      "version": 99,
      "versionNonce": 1514668011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790864990114,
      "created": 1790864974496,
      "link": null,
      "locked": false,
      "text": "+---------+-------------------+-----------------------------------+---------------------------------------+\n| CF      | Before Prewrite   | After Prewrite                    | After Commit                          |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| lock    | no txn-100 record | E -> Lock{start_ts=100, type=Put} | Delete(E)                             |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| default | no txn-100 record | E || desc(100) -> full value      | unchanged                             |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| write   | old versions only | no txn-100 record                 | E || desc(120) -> Write{start_ts=100} |\n+---------+-------------------+-----------------------------------+---------------------------------------+",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+---------+-------------------+-----------------------------------+---------------------------------------+\n| CF      | Before Prewrite   | After Prewrite                    | After Commit                          |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| lock    | no txn-100 record | E -> Lock{start_ts=100, type=Put} | Delete(E)                             |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| default | no txn-100 record | E || desc(100) -> full value      | unchanged                             |\n+---------+-------------------+-----------------------------------+---------------------------------------+\n| write   | old versions only | no txn-100 record                 | E || desc(120) -> Write{start_ts=100} |\n+---------+-------------------+-----------------------------------+---------------------------------------+",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
