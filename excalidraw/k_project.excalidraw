      "boundElements": null,
      "updated": 1784790876376,
      "link": null,
      "locked": false,
      "text": "MetricMapKey Skeleton // 查找时不复制 metric name, 比较转换成 `Slice`\n+----------------+-------------+-------------------------------+\n| metric_ptr_    | name_size_  | reference to external name    |\n+----------------+-------------+-------------------------------+\n| nullptr        | 4 B         | no inline name ownership      |\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MetricMapKey Skeleton // 查找时不复制 metric name, 比较转换成 `Slice`\n+----------------+-------------+-------------------------------+\n| metric_ptr_    | name_size_  | reference to external name    |\n+----------------+-------------+-------------------------------+\n| nullptr        | 4 B         | no inline name ownership      |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LynEbWqevZbOPDDvrv3Pg",
      "type": "text",
