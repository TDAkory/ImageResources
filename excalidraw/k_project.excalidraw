      "isDeleted": false,
      "boundElements": [
        {
          "id": "V4Ndvi7ui7Q297pEub01a",
          "type": "arrow"
        }
      ],
      "updated": 1786607336719,
      "link": null,
      "locked": false,
      "text": "etag_filters\n  |\n  v\nfor each tag filter\n  |\n  +-- tag_key uses HashIndex     -> QueryHashIndex\n  |\n  +-- tag_key uses InvertedIndex -> QueryInvertedIndex\n  |\n  +-- index DONE and cost acceptable:\n  |       ids = first ? union_ids : ids & union_ids\n  |\n  +-- index missing / not DONE / cost too high:\n          remain_etag_filters.push_back(filter)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "etag_filters\n  |\n  v\nfor each tag filter\n  |\n  +-- tag_key uses HashIndex     -> QueryHashIndex\n  |\n  +-- tag_key uses InvertedIndex -> QueryInvertedIndex\n  |\n  +-- index DONE and cost acceptable:\n  |       ids = first ? union_ids : ids & union_ids\n  |\n  +-- index missing / not DONE / cost too high:\n          remain_etag_filters.push_back(filter)",
      "autoResize": true,
      "lineHeight": 1.25
    },
