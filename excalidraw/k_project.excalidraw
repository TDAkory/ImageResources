      "text": "MemTable time domain\n\n                    base_time\n                        |\n                        v\nmin_valid_time  <--------+--------> max_valid_time\n                negative | positive\n                offset   | offset\n\nstored ts with different bytes based on range:\n\nabsolute_ts = base_time_ + timestamp_offset",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MemTable time domain\n\n                    base_time\n                        |\n                        v\nmin_valid_time  <--------+--------> max_valid_time\n                negative | positive\n                offset   | offset\n\nstored ts with different bytes based on range:\n\nabsolute_ts = base_time_ + timestamp_offset",
      "autoResize": true,
      "lineHeight": 1.25
    },
