      "isDeleted": false,
      "boundElements": null,
      "updated": 1784790734750,
      "link": null,
      "locked": false,
      "text": "WAL File: <16-digit-create_time_ms>_<start_lsn>\n  |\n  +-- WalBlock\n  |   |\n  |   +-- WalBlockHeader, 16 B\n  |   |\n  |   +-- payload, len bytes\n  |       |\n  |       +-- no compression:\n  |       |   +-- WalRecords\n  |       |   +-- Padding\n  |       |\n  |       +-- compressed:\n  |           +-- raw_size, 4 B\n  |           +-- compressed WalRecords\n  |           +-- Padding\n  |\n  +-- WalBlock\n      |\n      +-- WalRecord\n          |\n          +-- WalRecordHeader\n          |\n          +-- WalRecordElement V2\n              |\n              +-- tenant_id\n              +-- shard_id\n              +-- pkt_cnt\n              +-- packets",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WAL File: <16-digit-create_time_ms>_<start_lsn>\n  |\n  +-- WalBlock\n  |   |\n  |   +-- WalBlockHeader, 16 B\n  |   |\n  |   +-- payload, len bytes\n  |       |\n  |       +-- no compression:\n  |       |   +-- WalRecords\n  |       |   +-- Padding\n  |       |\n  |       +-- compressed:\n  |           +-- raw_size, 4 B\n  |           +-- compressed WalRecords\n  |           +-- Padding\n  |\n  +-- WalBlock\n      |\n      +-- WalRecord\n          |\n          +-- WalRecordHeader\n          |\n          +-- WalRecordElement V2\n              |\n              +-- tenant_id\n              +-- shard_id\n              +-- pkt_cnt\n              +-- packets",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
