      "updated": 1784790734750,
      "link": null,
      "locked": false,
      "text": "    Wal Block Uncompressed\n    +----------------+-------------------------------------+-------------+                \n    | WalBlockHeader | WalRecord #0 ... WalRecord #N       | Padding     |                \n    +----------------+-------------------------------------+-------------+                \n    |<---- 16 B ---->|<----------- len - padding_len ----->|<padding_len>|                \n                     |<-------------------- len ------------------------>|",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    Wal Block Uncompressed\n    +----------------+-------------------------------------+-------------+                                                                   \n    | WalBlockHeader | WalRecord #0 ... WalRecord #N       | Padding     |                                                                   \n    +----------------+-------------------------------------+-------------+                                                                   \n    |<---- 16 B ---->|<----------- len - padding_len ----->|<padding_len>|                                                                   \n                     |<-------------------- len ------------------------>|",
      "autoResize": false,
      "lineHeight": 1.25
    },
