      "link": null,
      "locked": false,
      "text": "SSTableFooter.metric_index\n  offset = metric index absolute offset\n  size   = metric index total size\n\nSSTableFooter.metric_index_root_page\n  offset = root page relative offset inside metric index\n  size   = root page size\n\nroot absolute offset:\n  metric_index.offset + metric_index_root_page.offset",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSTableFooter.metric_index\n  offset = metric index absolute offset\n  size   = metric index total size\n\nSSTableFooter.metric_index_root_page\n  offset = root page relative offset inside metric index\n  size   = root page size\n\nroot absolute offset:\n  metric_index.offset + metric_index_root_page.offset",
      "autoResize": true,
      "lineHeight": 1.25
    }
