      "updated": 1787282611879,
      "link": null,
      "locked": false,
      "text": "leaf page\n+----------------+----------------+------------------------------+\n| page entry 0   | metric name    | metric block offset / size   |\n| page entry 1   | metric name    | metric block offset / size   |\n| ...            | ...            | ...                          |\n+----------------+----------------+------------------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "leaf page\n+----------------+----------------+------------------------------+\n| page entry 0   | metric name    | metric block offset / size   |\n| page entry 1   | metric name    | metric block offset / size   |\n| ...            | ...            | ...                          |\n+----------------+----------------+------------------------------+",
      "autoResize": true,
