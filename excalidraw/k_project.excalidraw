      "versionNonce": 1528297855,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1787192388429,
      "link": null,
      "locked": false,
      "text": "Footer region\n\n+----------------------+----------------+----------------+----------------+----------------+\n| protobuf payload     | crc            | size           | version        | magic          |\n+----------------------+----------------+----------------+----------------+----------------+\n| variable bytes       | 4 B            | 4 B            | 1 B            | 4 B            |\n+----------------------+----------------+----------------+----------------+----------------+\n                       <--------------------- FooterFixedSize = 13 B ---------------------->",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Footer region\n\n+----------------------+----------------+----------------+----------------+----------------+\n| protobuf payload     | crc            | size           | version        | magic          |\n+----------------------+----------------+----------------+----------------+----------------+\n| variable bytes       | 4 B            | 4 B            | 1 B            | 4 B            |\n+----------------------+----------------+----------------+----------------+----------------+\n                       <--------------------- FooterFixedSize = 13 B ---------------------->",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WU_Lq5_PTkt0QJX5voKAd",
