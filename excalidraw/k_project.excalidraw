      "link": null,
      "locked": false,
      "text": "MetricIndexPage\n+-------------------------------+\n| compressed index body         |\n+-------------------------------+\n| MetricIndexPageFooter protobuf|\n+-------------------------------+\n| PageCommonFooter              |\n+-------------------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MetricIndexPage\n+-------------------------------+\n| compressed index body         |\n+-------------------------------+\n| MetricIndexPageFooter protobuf|\n+-------------------------------+\n| PageCommonFooter              |\n+-------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zbJPg4qZr9ghqvtIUF2BJ",
      "type": "text",
      "x": 8397.758381677051,
      "y": -244.9336247519824,
      "width": 677.5990600585938,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
