      "versionNonce": 911706499,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790880292,
      "link": null,
      "locked": false,
      "text": "MetricObject\n+------------------+------------------------------------------------+\n| component        | role                                           |\n+------------------+------------------------------------------------+\n| dicts            | tag key / tag value / tag key set dictionaries |\n| field_dict       | field name <-> field id                        |\n| series_map       | encoded tag set -> SeriesKey                   |\n| series_keys      | series id -> SeriesKey*                        |\n| tag_key_set_ids  | sampled tag key set ids for metadata APIs      |\n| index            | optional in-memory tag filter index            |\n| series_num       | next series id and current cardinality         |\n| write counters   | dps count, duplicated count, rate checks       |\n+------------------+------------------------------------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MetricObject\n+------------------+------------------------------------------------+\n| component        | role                                           |\n+------------------+------------------------------------------------+\n| dicts            | tag key / tag value / tag key set dictionaries |\n| field_dict       | field name <-> field id                        |\n| series_map       | encoded tag set -> SeriesKey                   |\n| series_keys      | series id -> SeriesKey*                        |\n| tag_key_set_ids  | sampled tag key set ids for metadata APIs      |\n| index            | optional in-memory tag filter index            |\n| series_num       | next series id and current cardinality         |\n| write counters   | dps count, duplicated count, rate checks       |\n+------------------+------------------------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1jlyYGiE7GqBCzGVNG0Ky",
