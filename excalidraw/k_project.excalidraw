      "text": "Metric Block\n+------------------------------------------------+\n| metric payload                                 |\n|                                                |\n| column layout: many data/index/dict/bloom page |\n| or                                             |\n| PAX layout   : one PAX page                    |\n+------------------------------------------------+\n| Metric Footer                                  |\n|   protobuf MetricFooter                        |\n|   crc + size + version + magic                 |\n+------------------------------------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metric Block\n+------------------------------------------------+\n| metric payload                                 |\n|                                                |\n| column layout: many data/index/dict/bloom page |\n| or                                             |\n| PAX layout   : one PAX page                    |\n+------------------------------------------------+\n| Metric Footer                                  |\n|   protobuf MetricFooter                        |\n|   crc + size + version + magic                 |\n+------------------------------------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
