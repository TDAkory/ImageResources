      "versionNonce": 1994553,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786605132290,
      "link": null,
      "locked": false,
      "text": "MultiFieldDataPointSet read alignment\n\noriginal per-field columns\nfield A\n+------+-------+\n| ts   | value |\n+------+-------+\n| 10   | a10   |\n| 20   | a20   |\n| 30   | a30   |\n+------+-------+\nfield B\n+------+-------+\n| ts   | value |\n+------+-------+\n| 10   | b10   |\n| 30   | b30   |\n| 40   | b40   |\n+------+-------+\n\nmerge aligned columns\nts_set = union(A.timestamps, B.timestamps)\n+-------------------+------+------+------+------+\n| merged timestamps | 10   | 20   | 30   | 40   |\n+-------------------+------+------+------+------+\n| field A values    | a10  | a20  | a30  | null |\n| field A bitmap    | 0    | 0    | 0    | 1    |\n| field B values    | b10  | null | b30  | b40  |\n| field B bitmap    | 0    | 1    | 0    | 0    |\n+-------------------+------+------+------+------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MultiFieldDataPointSet read alignment\n\noriginal per-field columns\nfield A\n+------+-------+\n| ts   | value |\n+------+-------+\n| 10   | a10   |\n| 20   | a20   |\n| 30   | a30   |\n+------+-------+\nfield B\n+------+-------+\n| ts   | value |\n+------+-------+\n| 10   | b10   |\n| 30   | b30   |\n| 40   | b40   |\n+------+-------+\n\nmerge aligned columns\nts_set = union(A.timestamps, B.timestamps)\n+-------------------+------+------+------+------+\n| merged timestamps | 10   | 20   | 30   | 40   |\n+-------------------+------+------+------+------+\n| field A values    | a10  | a20  | a30  | null |\n| field A bitmap    | 0    | 0    | 0    | 1    |\n| field B values    | b10  | null | b30  | b40  |\n| field B bitmap    | 0    | 1    | 0    | 0    |\n+-------------------+------+------+------+------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
