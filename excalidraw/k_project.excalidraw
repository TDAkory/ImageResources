      "isDeleted": false,
      "boundElements": null,
      "updated": 1787282591495,
      "link": null,
      "locked": false,
      "text": "uncompressed body\n+------------------+------------------+------------------+------------------+\n| restart block 0  | restart block 1  | ...              | restart offsets  |\n+------------------+------------------+------------------+------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uncompressed body\n+------------------+------------------+------------------+------------------+\n| restart block 0  | restart block 1  | ...              | restart offsets  |\n+------------------+------------------+------------------+------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IhfgCU_gkciU4M3ck_b9J",
      "type": "text",
      "x": 8400.564359634638,
      "y": -105.54746403769673,
