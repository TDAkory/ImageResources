      "link": null,
      "locked": false,
      "text": "非 restart entry 使用前缀压缩：\n+----------------+----------------+----------------+----------------+----------------+\n| shared_len     | non_shared_len | non_shared key | offset         | size           |\n+----------------+----------------+----------------+----------------+----------------+\n| varint32       | varint32       | bytes          | varint64       | varint64       |\n+----------------+----------------+----------------+----------------+----------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "非 restart entry 使用前缀压缩：\n+----------------+----------------+----------------+----------------+----------------+\n| shared_len     | non_shared_len | non_shared key | offset         | size           |\n+----------------+----------------+----------------+----------------+----------------+\n| varint32       | varint32       | bytes          | varint64       | varint64       |\n+----------------+----------------+----------------+----------------+----------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
