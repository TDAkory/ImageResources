    {
      "id": "_iRJOYZim7NSNOr2tso8n",
      "type": "text",
      "x": 9348.946304563495,
      "y": -145.00616939483962,
      "width": 555.1995849609375,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4i",
      "roundness": null,
      "seed": 1651800593,
      "version": 274,
      "versionNonce": 187095103,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787282611879,
      "link": null,
      "locked": false,
      "text": "root page 也是一个 internal page\nappend metric entries\n  -> leaf page 满了就切新 leaf page\n  -> Finish() 时为当前这一层 children 生成 parent internal page\n  -> 如果 parent internal page 也超过一个，继续向上生成新的 parent\n  -> 直到最后只剩一个 page，这个 page 就是 root page",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "root page 也是一个 internal page\nappend metric entries\n  -> leaf page 满了就切新 leaf page\n  -> Finish() 时为当前这一层 children 生成 parent internal page\n  -> 如果 parent internal page 也超过一个，继续向上生成新的 parent\n  -> 直到最后只剩一个 page，这个 page 就是 root page",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ey99wxzXBrGhct1DJSMVt",
