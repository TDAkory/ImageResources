      "updated": 1787282330897,
      "link": null,
      "locked": false,
      "text": "Footer region\n+----------------------+--------+--------+----------+---------+\n| protobuf payload     | crc    | size   | version  | magic   |\n+----------------------+--------+--------+----------+---------+\n| variable bytes       | 4 B    | 4 B    | 1 B      | 4 B     |\n+----------------------+--------+--------+----------+---------+\n                       <------ FooterFixedSize = 13 B -------->",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
