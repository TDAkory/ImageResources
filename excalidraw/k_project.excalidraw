      "updated": 1786605132290,
      "link": null,
      "locked": false,
      "text": "MultiFieldDataPointSet<T>\n+----------------+----------------+------------------------------------------+\n| allocator_     | std_allocator_ | field_map_                               |\n+----------------+----------------+------------------------------------------+\n                                  |\n                                  v\n                   std::map<int16_t, DataPointSet*>\n\n+------------+--------------------+\n| field_id   | DataPointSet*      |\n+------------+--------------------+\n| field 1    | SimpleDPS<T, type> |\n| field 2    | SimpleDPS<T, type> |\n| field 7    | SimpleDPS<T, type> |\n+------------+--------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MultiFieldDataPointSet<T>\n+----------------+----------------+------------------------------------------+\n| allocator_     | std_allocator_ | field_map_                               |\n+----------------+----------------+------------------------------------------+\n                                  |\n                                  v\n                   std::map<int16_t, DataPointSet*>\n\n+------------+--------------------+\n| field_id   | DataPointSet*      |\n+------------+--------------------+\n| field 1    | SimpleDPS<T, type> |\n| field 2    | SimpleDPS<T, type> |\n| field 7    | SimpleDPS<T, type> |\n+------------+--------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8C8BrtIgoHPKZLckPnxmC",
      "type": "text",
      "x": 3196.427875337148,
      "y": 594.3612351190473,
      "width": 431.19940185546875,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
