      "updated": 1787282617957,
      "link": null,
      "locked": false,
      "text": "MetricIndex entry in logic\n// metric block 的位置由 metric index 保存\n+----------------+----------------+----------------+\n| metric name    | offset         | size           |\n+----------------+----------------+----------------+\n| cpu.load       | 1048576        | 262144         |\n+----------------+----------------+----------------+\noffset = metric block absolute offset\nsize   = metric payload + metric footer total size",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MetricIndex entry in logic\n// metric block 的位置由 metric index 保存\n+----------------+----------------+----------------+\n| metric name    | offset         | size           |\n+----------------+----------------+----------------+\n| cpu.load       | 1048576        | 262144         |\n+----------------+----------------+----------------+\noffset = metric block absolute offset\nsize   = metric payload + metric footer total size",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8FEKSjFqizUhBTyvFkzrE",
      "type": "text",
      "x": 6071.358529227119,
      "y": -172.03036644345252,
      "width": 870.3843180338542,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
