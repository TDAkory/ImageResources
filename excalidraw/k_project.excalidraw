      "updated": 1787282591495,
      "link": null,
      "locked": false,
      "text": "restart entry 保存完整 key：\n+----------------+----------------+----------------+----------------+\n| key_len        | key bytes      | offset         | size           |\n+----------------+----------------+----------------+----------------+\n| varint32       | key_len bytes  | varint64       | varint64       |\n+----------------+----------------+----------------+----------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "restart entry 保存完整 key：\n+----------------+----------------+----------------+----------------+\n| key_len        | key bytes      | offset         | size           |\n+----------------+----------------+----------------+----------------+\n| varint32       | key_len bytes  | varint64       | varint64       |\n+----------------+----------------+----------------+----------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gOZ_nQCy4-N06eQmHBjB7",
      "type": "text",
      "x": 8396.724284822976,
      "y": 43.420169890874945,
