      "boundElements": null,
      "updated": 1787281798903,
      "link": null,
      "locked": false,
      "text": "Metric Index region\n+---------------------+\n| leaf page 0         |\n+---------------------+\n| leaf page 1         |\n+---------------------+\n| ...                 |\n+---------------------+\n| internal page 0     |\n+---------------------+\n| ...                 |\n+---------------------+\n| root page           |\n+---------------------+",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metric Index region\n+---------------------+\n| leaf page 0         |\n+---------------------+\n| leaf page 1         |\n+---------------------+\n| ...                 |\n+---------------------+\n| internal page 0     |\n+---------------------+\n| ...                 |\n+---------------------+\n| root page           |\n+---------------------+",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
